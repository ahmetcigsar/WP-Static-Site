msgstr "Empareja cualquier palabra"

#: ragnus-static-publisher/includes/class-admin.php:540
msgid "İndeksleme Seçicileri"
msgstr "Selectores de indexación"

#: ragnus-static-publisher/includes/class-admin.php:541
