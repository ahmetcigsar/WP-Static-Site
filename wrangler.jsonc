{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wext-static-publisher",
  "compatibility_date": "2026-08-11",
  "main": "./src/worker.mjs",
  "assets": {
    "directory": "./site-dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/"]
  }
}
