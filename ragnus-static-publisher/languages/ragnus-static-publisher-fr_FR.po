msgid "Bulanıklık Eşiği"
msgstr "Seuil de flou"

#: ragnus-static-publisher/includes/class-admin.php:536
msgid "Düşük değer daha kesin, yüksek değer daha toleranslı sonuç verir."
msgstr ""
"Une valeur plus faible donne un résultat plus précis, une valeur plus élevée"
" donne un résultat plus tolérant."

#: ragnus-static-publisher/includes/class-admin.php:537
msgid "Kelime Eşleştirme"
msgstr "Correspondance de mots"

#: ragnus-static-publisher/includes/class-admin.php:538
msgid "Tüm kelimeler eşleşsin"
msgstr "Faire correspondre tous les mots"

#: ragnus-static-publisher/includes/class-admin.php:539
msgid "Herhangi bir kelime eşleşsin"
msgstr "Faites correspondre n'importe quel mot"

#: ragnus-static-publisher/includes/class-admin.php:540
msgid "İndeksleme Seçicileri"
msgstr "Sélecteurs d'indexation"

#: ragnus-static-publisher/includes/class-admin.php:541
msgid ""
"Sayfa ve yazı HTML’inden hangi alanların alınacağını CSS selector ile "
"belirleyin."
msgstr ""
"Déterminez les champs à extraire de la page et publiez du HTML avec le "
"sélecteur CSS."

